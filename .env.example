# =====================================================================
# AI PROVIDER — pick ONE of the two blocks below.
# =====================================================================

# ---- Option A: Anthropic directly (default) ----
ANTHROPIC_API_KEY=sk-ant-...
JOBHUNTER_SCORING_MODEL=claude-haiku-4-5
JOBHUNTER_GENERATION_MODEL=claude-sonnet-5

# ---- Option B: any OpenAI-compatible provider ----
# Works with OpenRouter, OpenAI, Mistral, Groq, DeepSeek, Together, Ollama...
# Uncomment these (and comment out Option A) to switch.
#
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
#
# NEVER put a real key in this file — it is a template and IS committed to git.
# Real values belong in .env (which is gitignored).
#
# Verified working model IDs on OpenRouter (same pair as the Anthropic default):
# JOBHUNTER_SCORING_MODEL=anthropic/claude-haiku-4.5
# JOBHUNTER_GENERATION_MODEL=anthropic/claude-sonnet-5
#
# Cheaper option for the high-volume scoring step:
# JOBHUNTER_SCORING_MODEL=google/gemini-2.5-flash-lite
#
# Other base URLs:
#   OpenAI    https://api.openai.com/v1
#   Mistral   https://api.mistral.ai/v1
#   Groq      https://api.groq.com/openai/v1
#   DeepSeek  https://api.deepseek.com
#   Ollama    http://localhost:11434/v1   (local, free)

# =====================================================================
# OPTIONAL AGGREGATOR APIs — each turns on only when its key is filled in.
# Leave blank to skip. Nothing here is required.
# =====================================================================

# --- FREE, key by signup/request ---
# Careerjet (~90 countries incl. Italy): careerjet.com/partners
# Set LOCALE to it_IT for Italy. REFERER must be a URL you control.
CAREERJET_AFFID=
CAREERJET_LOCALE=it_IT
CAREERJET_REFERER=http://localhost
# Jooble (~70 countries incl. Italy): jooble.org/api/about
JOOBLE_API_KEY=
# Reed (UK): reed.co.uk/developers
REED_API_KEY=
# Findwork (tech/developer): findwork.dev/developers
FINDWORK_API_KEY=
# Web3.career (crypto, freemium): web3.career/web3-jobs-api
WEB3CAREER_API_KEY=

# --- PAID, metered per search ---
# SerpApi = Google for Jobs (indexes Indeed, LinkedIn, Glassdoor in one call).
# 250 free searches/month, then $25/mo for 1,000. Searches used per run =
# SERPAPI_MAX_TERMS x SERPAPI_MAX_LOCATIONS (default 4 x 2 = 8/day ≈ 240/month,
# which fits the free tier). Raise only if you upgrade.
SERPAPI_KEY=
SERPAPI_MAX_TERMS=4
SERPAPI_MAX_LOCATIONS=2
# JSearch (cheaper Google-Jobs wrapper, via RapidAPI) — check current limits.
JSEARCH_API_KEY=

# =====================================================================
# WEB APP (only needed if you run the JBHNTR website, not the CLI)
# =====================================================================
# Generate these two:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
FILE_ENCRYPTION_KEY=
DEBUG=true
BASE_URL=http://localhost:8000
# DATABASE_URL is injected by Railway; locally it defaults to SQLite.

# Which model scores jobs, per plan. The free tier defaults to a cheap model —
# set it to the same as premium if match quality matters more than cost.
FREE_SCORING_MODEL=google/gemini-2.5-flash-lite
PREMIUM_SCORING_MODEL=anthropic/claude-haiku-4.5

# Plan limits — these are what protect your AI bill.
# Free is a lifetime allowance; Premium document allowances reset each calendar month.
FREE_SEARCHES=3
FREE_CVS=3
FREE_COVER_LETTERS=3
PREMIUM_CVS_MONTHLY=30
PREMIUM_COVER_LETTERS_MONTHLY=20
PREMIUM_AUTO_SEARCHES_PER_DAY=1
PREMIUM_SEARCHES_PER_DAY=2

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLAUSIBLE_DOMAIN=
SUPPORT_EMAIL=support@jbhntr.app
PAYMENTS_ENABLED=false

# ---- Adzuna (free tier: https://developer.adzuna.com/) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for Adzuna endpoint (gb, us, it, de, fr, ...)
ADZUNA_COUNTRY=gb

# ---- Google service account ----
# Path to the downloaded service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# The Google Sheet to write results to (create it, share with the SA email).
GOOGLE_SHEET_ID=
# Google Drive folder ID where generated CV/CL docs are stored (share with SA email).
GOOGLE_DRIVE_FOLDER_ID=

# ---- Email digest (SMTP) ----
# For Gmail: host=smtp.gmail.com port=587, user=you@gmail.com, pass=<app password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
